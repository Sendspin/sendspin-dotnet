<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Every dependency comes from nuget.org. <clear /> drops whatever feeds a machine or user
    config adds, so a same-named package on another feed can never be picked up instead.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
