<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Both frameworks the library ships, so the net8.0 side of every #if is executable.
      #108 was three separate net8.0-vs-net10.0 disagreements in Base64UrlText.Decode, none
      of them reachable from a net10.0-only suite (#155).
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sendspin.SDK\Sendspin.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Connection\cpace-kats.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Connection\pin-kats.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>